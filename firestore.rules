rules_version = '2';

// Faqat yangi natija qo'shish va o'qishga ruxsat. O'zgartirish yoki o'chirish mumkin emas.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{board}/{id} {
      allow read: if board in ['scores_normal', 'scores_hard'];

      allow create: if board in ['scores_normal', 'scores_hard']
        && request.resource.data.keys().hasOnly(['name', 'score', 'words', 'wpm'])
        && request.resource.data.keys().hasAll(['name', 'score', 'words', 'wpm'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 12
        && request.resource.data.score is int
        && request.resource.data.score > 0
        && request.resource.data.score <= 1000000
        && request.resource.data.words is int
        && request.resource.data.words > 0
        && request.resource.data.words <= 2000
        && request.resource.data.wpm is int
        && request.resource.data.wpm >= 0
        && request.resource.data.wpm <= 250;

      allow update, delete: if false;
    }
  }
}
